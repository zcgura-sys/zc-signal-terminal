{
  // ================================================================
  // SIGNAL · Cloudflare Workers 配置（Git 连接 · 自动部署）
  // 本文件是部署的唯一事实来源 —— 改完 push 就自动上线。
  // ================================================================

  // Worker 名字：会变成 <name>.<你的账号子域>.workers.dev
  // ⚠️ 和 GitHub 仓库名保持一致最省事；名字要够独特（重名会部署失败）
  //    注：线上实际是 zcc.zcatri520.workers.dev —— 说明控制台里的项目名优先，
  //    这里保持你原来的值不动，避免影响部署目标。
  "name": "signal-worker",

  // 入口：自包含单文件（前端已内嵌，不需要静态资源目录）
  "main": "_worker.js",

  // 兼容日期：可保持不动
  "compatibility_date": "2026-10-01",

  // ⚠️⚠️ 唯一必须改的地方 ⚠️⚠️
  // 把下面 id 换成你自己的 KV 命名空间 ID（32 位十六进制）
  // 位置：Cloudflare 控制台 → 左侧「存储和数据库 / Storage & Databases」
  //       → 「KV」→ 点开你的命名空间 → 复制 Namespace ID
  // 注：你线上 KV 现在是「在控制台绑定的」（本文件这行仍是占位符也能用），
  //     所以这一段可以保持原样，不影响。
  "kv_namespaces": [
    { "binding": "ZC_KV", "id": "b786c8e026294bf58d3e47cbfb0f4538" }
  ],

  // ================================================================
  // ↓↓↓ 本次新增：D1（SQLite）存储绑定 —— 摆脱 KV 免费版「1000 写/天」↓↓↓
  //   binding 必须叫 DB（代码里按 env.DB 识别）
  //   表结构由代码自动创建，不需要手动执行 SQL
  //   KV 里的旧账号会在「第一次用到」时自动搬进 D1，原密码照旧能登录
  //   没绑定 D1、或 D1 报错时，会自动回退 KV，站点不会挂
  //   database_name 只是标签，建议改成你实际创建的库名
  // ================================================================
  "d1_databases": [
    { "binding": "DB", "database_name": "gura-db", "database_id": "6e844fff-c1e2-4312-858e-33c39d5868d1" }
  ],

  // ================================================================
  // ↓↓↓ v2.23 新增：静态资源（前后端分离）↓↓↓
  //   前端页面已从 _worker.js 中抽出，放在 public/ 目录里：
  //     public/index.html   主应用（原内嵌 HTML，逐字节一致）
  //     public/admin.html   用户管理页
  //
  //   为什么必须放在 public/ 子目录（而不是仓库根目录）：
  //   ⚠️ 静态资源目录里「只要出现名为 _worker.js 的文件」，Cloudflare 就会
  //   直接拒绝部署并报错：
  //     ✘ Uploading a Pages _worker.js file as an asset.
  //       This could expose your private server-side code to the public Internet.
  //   （防止后端源码被当作静态资源公开下载）。若把 entire 仓库根目录当作
  //   静态资源目录，_worker.js 就落在里面，必然触发该错误；
  //   为了绕开它而依赖 .assetsignore 又太脆弱（例如手机上传时漏传这个隐藏
  //   文件就会部署失败、甚至泄露源码）。放到 public/ 子目录后，_worker.js
  //   天然在静态资源范围之外，问题从根上消失。
  //
  //   run_worker_first: true —— 先经过 Worker（安全网关 / 鉴权），
  //   再由 Worker 用 env.ASSETS.fetch() 取静态文件；否则静态文件会绕过安全层。
  //   取不到静态资源时，Worker 会回退到一份极简兜底页，站点不会白屏。
  //   public/.assetsignore 为公开清单（* + !index.html + !admin.html）。
  // ================================================================
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // ================================================================
  // v2.30 可选变量一览（全部可选；密钥类请在控制台「变量和机密」里以「密钥」添加，不要写进本文件）
  //   安全：ZC_CSP_MODE(enforce|report|off)  ZC_ROLE_ADMINS  ZC_DATA_KEY
  //   登录：GOOGLE_OAUTH_CLIENT_ID/SECRET  MICROSOFT_OAUTH_CLIENT_ID/SECRET/TENANT  ZC_AUTH_OAUTH_DOMAINS
  //   集成：MCP_SERVERS  RAG_EMBED_API_KEY
  //   观测：ZC_LOG_LEVEL  OTEL_EXPORTER_OTLP_ENDPOINT/HEADERS  SIEM_URL/TOKEN/FORMAT/HMAC_KEY
  // ================================================================

  // 开启日志（出错时能在控制台看到原因）
  "observability": { "enabled": true }
}
